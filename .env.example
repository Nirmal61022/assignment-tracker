# Environment variables for Assignment Tracker
# Copy this to .env and fill in your values

# Django secret key (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=your-secret-key-here

# Debug mode (False in production)
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL (SQLite for local, PostgreSQL for production)
# SQLite (default): sqlite:///db.sqlite3
# PostgreSQL: postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# For production only - comma-separated list of trusted CSRF origins
# CSRF_TRUSTED_ORIGINS=https://your-domain.com

# MongoDB URI for AI Assistant chat logs and student feedback
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# (If not set, system automatically operates with resilient local buffer logging)
MONGODB_URI=
MONGODB_DB=assignment_tracker

# Optional Google Gemini API key for enhanced natural language AI queries
# (If not provided, system uses intelligent built-in SQL FAQ & Error Code search engine)
GEMINI_API_KEY=

